post_install() {
	if [ -f /usr/share/pekarchos/os-release ]; then
		install -Dm644 /usr/share/pekarchos/os-release /usr/lib/os-release
		ln -sfn ../usr/lib/os-release /etc/os-release
	fi

	# No se empaqueta /etc/skel/.bashrc: lo posee bash. Se añade al final.
	if [ -f /etc/skel/.bashrc ] && ! grep -q 'pekarchos-prompt' /etc/skel/.bashrc; then
		cat >>/etc/skel/.bashrc <<'EOF'

# pekarchos-prompt
PS1='\[\e[38;2;0;240;255m\]\u@\h\[\e[0m\]:\[\e[38;2;255;43;214m\]\w\[\e[0m\]\$ '
EOF
	fi

	if [ -f /etc/bash.bashrc ] && ! grep -q 'pekarchos-fastfetch' /etc/bash.bashrc; then
		cat >>/etc/bash.bashrc <<'EOF'

# pekarchos-fastfetch
case $- in
*i*) command -v fastfetch >/dev/null 2>&1 && fastfetch ;;
esac
EOF
	fi

	# archinstall crea al usuario antes de instalar este paquete.
	# No pisa archivos que el usuario ya tenga. Copia lo que falte del esqueleto.
	if [ -d /etc/skel ] && [ -d /home ]; then
		for home in /home/*; do
			[ -d "$home" ] || continue
			user=$(basename "$home")
			if id "$user" >/dev/null 2>&1; then
				cp -a --update=none /etc/skel/. "$home/"
				chown -R "$user:$user" "$home"
			fi
		done
	fi

	if command -v plymouth-set-default-theme >/dev/null 2>&1; then
		plymouth-set-default-theme -R pekarchos || true
	fi
	if command -v gtk-update-icon-cache >/dev/null 2>&1; then
		gtk-update-icon-cache -qf /usr/share/icons/hicolor || true
	fi
}

post_upgrade() {
	post_install
}

# Maintainer: Pekapro
pkgname=pekarchos-branding
if [[ -z "${startdir:-}" ]]; then
	startdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
_version_file="${startdir}/VERSION"
if [[ ! -f "${_version_file}" ]]; then
	_version_file="${startdir}/../../VERSION"
fi
if [[ ! -f "${_version_file}" ]]; then
	echo "PKGBUILD: no está el archivo VERSION de PekarchOS." >&2
	exit 1
fi
pkgver=$(tr -d '[:space:]' < "${_version_file}")
pkgrel=1
pkgdesc='Marca, iconos, bienvenida y ajustes visuales de PekarchOS'
arch=(any)
url='https://github.com/pekapro-lab/pekarchos'
license=('CC0-1.0' 'CC-BY-SA-4.0' 'GPL-3.0-or-later')
depends=('bash' 'python-pyqt6' 'plymouth' 'hicolor-icon-theme')
install="${pkgname}.install"
options=('!debug')
sha256sums=()

package() {
	cp -a "${startdir}/root/." "${pkgdir}/"
	install -Dm644 "${_version_file}" "${pkgdir}/usr/share/pekarchos/VERSION"
	marca="${pkgdir}/usr/share/calamares/branding/pekarchos"
	install -d "${marca}"
	cp -a "${pkgdir}/usr/share/pekarchos/logo.png" "${marca}/logo.png"
	cp -a "${pkgdir}/usr/share/pekarchos/logo-full.png" "${marca}/logo-full.png"
	sed -i "s/@PEKARCHOS_VERSION@/${pkgver}/g" \
		"${pkgdir}/usr/share/pekarchos/os-release" \
		"${pkgdir}/etc/xdg/kcm-about-distrorc" \
		"${marca}/branding.desc"
	if grep -q '@PEKARCHOS_VERSION@' "${pkgdir}/usr/share/pekarchos/os-release" "${marca}/branding.desc"; then
		echo "No se sustituyó la versión en os-release o en Calamares." >&2
		exit 1
	fi
	if compgen -G "${pkgdir}/usr/local/bin/*" >/dev/null; then
		chmod 755 "${pkgdir}/usr/local/bin/"*
	fi
	if compgen -G "${pkgdir}/usr/lib/pekarchos/"*.sh >/dev/null; then
		chmod 755 "${pkgdir}/usr/lib/pekarchos/"*.sh
	fi
	find "${pkgdir}" -type d -exec chmod 755 {} +
}

[Desktop Entry]
Type=Application
Name=Bienvenida PekarchOS
Comment=Se abre al entrar en un sistema instalado
Exec=/usr/local/bin/pekarchos-welcome --autostart
Icon=pekarchos
Terminal=false
OnlyShowIn=KDE;XFCE;X-Cinnamon;GNOME;MATE;
X-KDE-autostart-phase=2
X-GNOME-Autostart-enabled=true
NoDisplay=true

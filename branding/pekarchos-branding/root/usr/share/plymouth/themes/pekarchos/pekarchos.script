logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_bar.original = Image("progress_bar.png");
progress_bar.sprite = Sprite();

fun refresh () {
    logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
    logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 20);
    progress_box.sprite.SetX(Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2);
    progress_box.sprite.SetY(Window.GetHeight() - 72);
    progress_bar.sprite.SetX(progress_box.sprite.GetX());
    progress_bar.sprite.SetY(progress_box.sprite.GetY());
}

Plymouth.SetRefreshFunction(refresh);

fun progress_callback (duration, time) {
    if (duration <= 0) {
        return;
    }
    local ratio = time / duration;
    if (ratio < 0) {
        ratio = 0;
    }
    if (ratio > 1) {
        ratio = 1;
    }
    local width = Math.Int(progress_bar.original.GetWidth() * ratio);
    if (width < 1) {
        width = 1;
    }
    progress_bar.sprite.SetImage(progress_bar.original.Scale(width, progress_bar.original.GetHeight()));
    progress_bar.sprite.SetX(Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2);
    progress_bar.sprite.SetY(Window.GetHeight() - 72);
}

Plymouth.SetBootProgressFunction(progress_callback);

Window.SetBackgroundTopColor(0.03, 0.09, 0.20);
Window.SetBackgroundBottomColor(0.01, 0.04, 0.11);

def read_os_release() -> dict[str, str]:
    data: dict[str, str] = {}
    for path in (Path("/etc/os-release"), Path("/usr/lib/os-release")):
        if not path.is_file():
            continue
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            if "=" not in line or line.startswith("#"):
                continue
            key, value = line.split("=", 1)
            data[key] = value.strip().strip('"')
        if data:
            break
    return data


def cpu_summary() -> str:
    model = "desconocida"
    try:
        for line in Path("/proc/cpuinfo").read_text(encoding="utf-8", errors="replace").splitlines():
            if line.lower().startswith("model name"):
                model = line.split(":", 1)[1].strip()
                break
    except OSError:
        pass
    threads = os.cpu_count() or 1
    return f"{model} ({threads} hilos)"


def ram_summary() -> str:
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8", errors="replace").splitlines():
            if line.startswith("MemTotal:"):
                kib = int(line.split()[1])
                return f"{kib / 1024 / 1024:.1f} GiB"
    except (OSError, ValueError, IndexError):
        pass
    return "desconocida"


def gpu_summary() -> str:
    if shutil.which("lspci"):
        try:
            out = subprocess.check_output(["lspci", "-mm"], text=True, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.CalledProcessError):
            out = ""
        found = []
        for line in out.splitlines():
            if "VGA" not in line and "3D controller" not in line and "Display controller" not in line:
                continue
            bits = [part for part in line.split('"') if part.strip()]
            if len(bits) >= 4:
                found.append(f"{bits[2]} {bits[3]}")
        if found:
            return "; ".join(found)
    drivers: list[str] = []
    drm = Path("/sys/class/drm")
    if drm.is_dir():
        for card in sorted(drm.glob("card[0-9]")):
            driver = card / "device" / "driver"
            if driver.exists():
                drivers.append(driver.resolve().name)
    if drivers:
        unique = list(dict.fromkeys(drivers))
        return "controlador " + ", ".join(unique)
    return "no detectada"


def plasma_version() -> str:
    try:
        out = subprocess.check_output(
            ["plasmashell", "--version"],
            text=True,
            stderr=subprocess.STDOUT,
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        return "no disponible"
    return out or "no disponible"


def package_installed(name: str) -> bool:
    return subprocess.call(["pacman", "-Q", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0


def chrome_installed() -> bool:
    if package_installed("google-chrome"):
        return True
    if shutil.which("flatpak") is None:
        return False
    return (
        subprocess.call(
            ["flatpak", "info", "com.google.Chrome"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        == 0
    )


def load_show_on_start() -> bool:
    if not CONFIG.is_file():
        return True
    parser = configparser.ConfigParser()
    parser.read(CONFIG, encoding="utf-8")
    return parser.getboolean("welcome", "show_on_start", fallback=True)


def save_show_on_start(enabled: bool) -> None:
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    parser = configparser.ConfigParser()
    parser["welcome"] = {"show_on_start": "true" if enabled else "false"}
    with CONFIG.open("w", encoding="utf-8") as handle:
        parser.write(handle)


class Welcome(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self.setWindowTitle("Bienvenida a PekarchOS")
        self.resize(980, 720)
        self.setStyleSheet(STYLE)
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self._read_log)
        self.proc.finished.connect(self._on_finished)
        self.boxes: list[tuple[QCheckBox, dict]] = []

        root = QVBoxLayout(self)
        root.setContentsMargins(18, 18, 18, 18)
        root.setSpacing(12)

        header = QHBoxLayout()
        logo = QLabel()
        pixmap = QPixmap(LOGO)
        if not pixmap.isNull():
            logo.setPixmap(pixmap.scaled(200, 200, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation))
        header.addWidget(logo)
        titles = QVBoxLayout()
        title = QLabel("PekarchOS")
        title.setObjectName("title")
        credit = QLabel("Hecho por Pekapro")
        credit.setObjectName("credit")
        titles.addWidget(title)
        titles.addWidget(credit)
        titles.addStretch(1)
        header.addLayout(titles, 1)
        root.addLayout(header)

        info = QLabel(self._info_text())
        info.setObjectName("muted")
        info.setWordWrap(True)
        info.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        root.addWidget(info)

        group = QGroupBox("Paquetes opcionales")
        grid = QGridLayout(group)
        for index, pack in enumerate(PACKS):
            box = QCheckBox(pack["title"])
            box.setToolTip(pack["blurb"])
            installed = all(package_installed(name) for name in pack["packages"])
            if installed:
                box.setText(pack["title"] + "  (instalado)")
                box.setChecked(True)
            hint = QLabel(pack["blurb"])
            hint.setObjectName("muted")
            hint.setWordWrap(True)
            row = index
            grid.addWidget(box, row, 0)
            grid.addWidget(hint, row, 1)
            self.boxes.append((box, pack))
        self.flatpak = QCheckBox("Activar Flatpak y Flathub")
        flatpak_hint = QLabel("Instala flatpak si falta y añade el remoto Flathub.")
        flatpak_hint.setObjectName("muted")
        flatpak_hint.setWordWrap(True)
        grid.addWidget(self.flatpak, len(PACKS), 0)
        grid.addWidget(flatpak_hint, len(PACKS), 1)
        self.chrome = QCheckBox("Instalar Google Chrome desde Flathub")
        self.chrome.setChecked(chrome_installed())
        chrome_hint = QLabel(
            "Firefox es el navegador por defecto y va en la ISO. Chrome no se redistribuye: "
            "se baja de Flathub (com.google.Chrome) y se actualiza solo. Hace falta red."
        )
        chrome_hint.setObjectName("muted")
        chrome_hint.setWordWrap(True)
        grid.addWidget(self.chrome, len(PACKS) + 1, 0)
        grid.addWidget(chrome_hint, len(PACKS) + 1, 1)
        grid.setColumnStretch(1, 1)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(group)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        root.addWidget(scroll, 1)

        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setPlaceholderText("El registro de pacman aparece aquí.")
        self.log.setFont(QFont("DejaVu Sans Mono", 10))
        self.log.setFixedHeight(160)
        root.addWidget(self.log)

        self.progress = QProgressBar()
        self.progress.setRange(0, 1)
        self.progress.setValue(0)
        root.addWidget(self.progress)

        actions = QHBoxLayout()
        self.startup = QCheckBox("Mostrar al iniciar")
        self.startup.setChecked(load_show_on_start())
        self.startup.toggled.connect(save_show_on_start)
        actions.addWidget(self.startup)
        actions.addStretch(1)
        self.install_button = QPushButton("Instalar selección")
        self.install_button.clicked.connect(self.install_selected)
        actions.addWidget(self.install_button)
        root.addLayout(actions)

    def _info_text(self) -> str:
        release = read_os_release()
        name = release.get("PRETTY_NAME") or release.get("NAME") or "PekarchOS"
        version = release.get("VERSION_ID") or release.get("VERSION") or "desconocida"
        return (
            f"{name}\n"
            f"Versión: {version}\n"
            f"Núcleo: {os.uname().release}\n"
            f"Plasma: {plasma_version()}\n"
            f"CPU: {cpu_summary()}\n"
            f"RAM: {ram_summary()}\n"
            f"GPU: {gpu_summary()}"
        )

    def install_selected(self) -> None:
        if self.proc.state() != QProcess.ProcessState.NotRunning:
            return
        packages: list[str] = []
        multilib = False
        for box, pack in self.boxes:
            if not box.isChecked():
                continue
            packages.extend(pack["packages"])
            multilib = multilib or bool(pack["multilib"])
        if not packages and not self.flatpak.isChecked() and not self.chrome.isChecked():
            self.log.setPlainText("No hay nada seleccionado.")
            return
        if not Path(INSTALLER).is_file():
            self.log.setPlainText(f"No está {INSTALLER}.")
            return
        args = [INSTALLER]
        if multilib:
            args.append("--enable-multilib")
        if self.flatpak.isChecked():
            args.append("--flathub")
        if self.chrome.isChecked():
            args.append("--chrome")
        args.append("--")
        args.extend(packages)
        self.log.clear()
        self.progress.setRange(0, 0)
        self.install_button.setEnabled(False)
        self.proc.start("pkexec", args)

    def _read_log(self) -> None:
        data = bytes(self.proc.readAllStandardOutput()).decode("utf-8", errors="replace")
        self.log.moveCursor(QTextCursor.MoveOperation.End)
        self.log.insertPlainText(data)
        self.log.moveCursor(QTextCursor.MoveOperation.End)

    def _on_finished(self, *args) -> None:
        code = int(args[0]) if args else 1
        self._finished(code)

    def _finished(self, code: int) -> None:
        self.progress.setRange(0, 1)
        self.progress.setValue(1 if code == 0 else 0)
        self.install_button.setEnabled(True)
        if code == 0:
            self.log.appendPlainText("\nInstalación terminada.")
        elif code in (126, 127):
            self.log.appendPlainText("\nInstalación cancelada o pkexec no pudo arrancar.")
        else:
            self.log.appendPlainText(f"\nPacman terminó con código {code}.")
        self._refresh_installed()

    def _refresh_installed(self) -> None:
        for box, pack in self.boxes:
            title = pack["title"]
            if all(package_installed(name) for name in pack["packages"]):
                box.setText(title + "  (instalado)")
                box.setChecked(True)
            else:
                box.setText(title)
        if chrome_installed():
            self.chrome.setText("Instalar Google Chrome desde Flathub  (instalado)")
            self.chrome.setChecked(True)
        else:
            self.chrome.setText("Instalar Google Chrome desde Flathub")


def main() -> int:
    autostart = "--autostart" in sys.argv
    if autostart:
        if Path("/run/archiso").is_dir():
            return 0
        if not load_show_on_start():
            return 0
    app = QApplication(sys.argv)
    app.setApplicationName("pekarchos-welcome")
    window = Welcome()
    window.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env bash
# Abre Calamares. En el live, sudo no pide contraseña y conserva Wayland.
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
	exec sudo -E -- "$0" "$@"
fi

if [[ ! -x /usr/bin/calamares ]]; then
	echo "Calamares no está instalado." >&2
	exit 1
fi

if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
	export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
fi

exec calamares "$@"

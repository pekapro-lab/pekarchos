#!/usr/bin/env bash
# Instala paquetes de la bienvenida. Lo lanza pkexec; escribe el registro por stdout.
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
	echo "pekarchos-welcome-install tiene que ejecutarse como root (pkexec)." >&2
	exit 1
fi

enable_multilib=0
enable_flathub=0
enable_chrome=0
packages=()
while [[ $# -gt 0 ]]; do
	case "$1" in
	--enable-multilib) enable_multilib=1 ;;
	--flathub) enable_flathub=1 ;;
	--chrome) enable_chrome=1 ;;
	--)
		shift
		packages+=("$@")
		break
		;;
	*) packages+=("$1") ;;
	esac
	shift
done

if [[ "${enable_multilib}" -eq 1 ]]; then
	echo "==> Activando el repositorio multilib"
	if grep -q '^\[multilib\]' /etc/pacman.conf; then
		echo "multilib ya estaba activo."
	elif grep -q '^#\[multilib\]' /etc/pacman.conf; then
		awk '
			/^#\[multilib\]$/ { print "[multilib]"; getline; if ($0 ~ /^#Include/) sub(/^#/, ""); print; next }
			{ print }
		' /etc/pacman.conf >/etc/pacman.conf.pekarchos
		mv /etc/pacman.conf.pekarchos /etc/pacman.conf
		echo "Se descomentó [multilib] en /etc/pacman.conf."
	else
		cat >>/etc/pacman.conf <<'EOF'

[multilib]
Include = /etc/pacman.d/mirrorlist
EOF
		echo "Se añadió [multilib] a /etc/pacman.conf."
	fi
fi

echo "==> Sincronizando bases de datos"
pacman -Sy --noconfirm

installable=()
for pkg in "${packages[@]}"; do
	if pacman -Si "${pkg}" >/dev/null 2>&1; then
		installable+=("${pkg}")
	else
		echo "AVISO: ${pkg} no está en los repositorios oficiales; se omite."
		if [[ "${pkg}" == "openshot" ]]; then
			echo "OpenShot salió de extra. En el AUR el empaquetado actual no construye en este Arch."
		fi
	fi
done

if [[ ${#installable[@]} -gt 0 ]]; then
	echo "==> Instalando: ${installable[*]}"
	pacman -S --needed --noconfirm "${installable[@]}"
else
	echo "No hay paquetes oficiales nuevos que instalar."
fi

quiere_docker=0
for pkg in "${packages[@]}"; do
	if [[ "${pkg}" == "docker" ]]; then
		quiere_docker=1
	fi
done
if [[ "${quiere_docker}" -eq 1 ]] && pacman -Q docker >/dev/null 2>&1; then
	echo "==> Activando Docker"
	if ! systemctl enable --now docker.service; then
		systemctl enable docker.service || true
		echo "Docker quedó habilitado. Si no arrancó, usa: sudo systemctl start docker"
	fi
	uid="${PKEXEC_UID:-${SUDO_UID:-}}"
	if [[ -n "${uid}" ]]; then
		cuenta=$(id -nu "${uid}" 2>/dev/null || true)
		if [[ -n "${cuenta}" ]]; then
			usermod -aG docker "${cuenta}"
			echo "Se añadió ${cuenta} al grupo docker. Cierra la sesión para que valga."
		fi
	fi
fi

if [[ "${enable_flathub}" -eq 1 || "${enable_chrome}" -eq 1 ]]; then
	echo "==> Flatpak y Flathub"
	pacman -S --needed --noconfirm flatpak
	flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo
	echo "Remoto Flathub listo."
fi

if [[ "${enable_chrome}" -eq 1 ]]; then
	echo "==> Google Chrome desde Flathub (no va dentro de la ISO)"
	flatpak install -y --noninteractive --system flathub com.google.Chrome
	echo "Chrome instalado. Firefox sigue siendo el navegador por defecto."
fi

echo "==> Hecho"
